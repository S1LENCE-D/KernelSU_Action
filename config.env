# ============================================
# 小米 11 Ultra (star) - SukiSU-Ultra v1.5
# ============================================
DEVICE=star
DEVICE_NAME="Xiaomi Mi 11 Ultra"

KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_xiaomi_sm8350
KERNEL_SOURCE_BRANCH=lineage-20
KERNEL_CONFIG=vendor/lahaina-qgki_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64

USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/ZyCromerZ/Clang/releases/download/15.0.7-20260801-release/Clang-15.0.7-20260801.tar.gz
CUSTOM_CLANG_BRANCH=

ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

KSU_VARIANT=sukisu-ultra
KSU_HOOK_MODE=manual

ENABLE_SUSFS=false
ENABLE_KPM=false
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false

DISABLE_LTO=true
DISABLE_CC_WERROR=true
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true

NEED_DTBO=false
MAKE_BOOT_IMAGE=false
